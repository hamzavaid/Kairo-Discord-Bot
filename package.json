{
  "name": "kairo-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@discordjs/voice": "0.19.2",
    "@eslint/js": "^9.39.5",
    "@kairo/data": "workspace:^",
    "@kairo/music-engine": "workspace:*",
    "@kairo/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "discord.js": "14.27.0",
    "eslint": "^9.39.5",
    "mongoose": "9.10.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.7"
  }
}
